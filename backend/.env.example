# Copy this file to .env and fill in real values. Never commit the real .env.
#
# Optional: enables live LLM-generated explanations via the Anthropic API.
# If unset, PatchPilot runs in a clearly labeled deterministic demo mode.
ANTHROPIC_API_KEY=your_api_key_here

# Optional: defaults to claude-sonnet-4-6 if unset.
ANTHROPIC_MODEL=claude-sonnet-4-6
